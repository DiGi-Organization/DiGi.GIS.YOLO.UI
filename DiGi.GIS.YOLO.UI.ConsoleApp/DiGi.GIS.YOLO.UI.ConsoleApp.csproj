<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<OutputPath>..\bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Redirect AssemblyAttributes.cs so each project has its own -->
		<TargetFrameworkMonikerAssemblyAttributesPath>$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs</TargetFrameworkMonikerAssemblyAttributesPath>
		<!-- Avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>
	<ItemGroup>
		<!-- Prevent duplicate 'Compile' inclusion of the generated AssemblyAttributes.cs -->
		<Compile Remove="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DiGi.GIS.YOLO.UI\DiGi.GIS.YOLO.UI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- Transitive dependencies of DiGi.GIS.ML, which is reached by HintPath and therefore carries none of its
		     own NuGet packages into this output. Kept in step with DiGi.GIS.ML's own .csproj, which declares exactly
		     these two: OrtoBuildingDetectionModel is a LightGbm regression pipeline and touches nothing else.
		     Microsoft.ML.TorchSharp, TorchSharp-cpu, Microsoft.ML.OneDal, Microsoft.ML.ImageAnalytics,
		     Microsoft.ML.FastTree, Plotly.NET and Microsoft.Bcl.Memory used to sit here. They were left behind by
		     DiGi-Organization/DiGi.GIS.ML#5's trim and were shipping about 1.6 GB of runtimes - torch_cpu and onedal
		     alone are 382 of the 386 MB in win-x64 native - to every deployment, for a model that never loaded them.
		     Verify with CheckHostDependencies.ps1 after changing this, not with a green build. -->
		<PackageReference Include="Microsoft.ML" Version="5.0.0" />
		<PackageReference Include="Microsoft.ML.LightGbm" Version="5.0.0" />

		<!-- Transitive dependencies of DiGi.GIS.WebAPI and DiGi.GIS.PostgreSQL -->
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
		<PackageReference Include="NetTopologySuite" Version="2.6.0" />
		<PackageReference Include="Npgsql" Version="10.0.2" />
		<PackageReference Include="ProjNET4GeoAPI" Version="1.4.1" />
		<PackageReference Include="QuikGraph" Version="2.5.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.5" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\DiGi.GIS.ML\DiGi.GIS.ML\OrtoBuildingDetectionModel.mlnet">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OrtoBuildingDetectionModel.mlnet</Link>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="DiGi.Analytical.Building">
			<HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.CityGML">
			<HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.IO">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.EPW">
			<HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry">
			<HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS">
			<HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.IO">
			<HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.ML">
			<HintPath>..\..\DiGi.GIS.ML\bin\DiGi.GIS.ML.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.PostgreSQL">
			<HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.GIS.PostgreSQL.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.WebAPI">
			<HintPath>..\..\DiGi.GIS.WebAPI\bin\DiGi.GIS.WebAPI.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.YOLO">
			<HintPath>..\..\DiGi.GIS.YOLO\bin\DiGi.GIS.YOLO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PostgreSQL.Table">
			<HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Serilog">
			<HintPath>..\..\DiGi.Serilog\bin\DiGi.Serilog.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.WebAPI">
			<HintPath>..\..\DiGi.WebAPI\bin\DiGi.WebAPI.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.YOLO">
			<HintPath>..\..\DiGi.YOLO\bin\DiGi.YOLO.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
