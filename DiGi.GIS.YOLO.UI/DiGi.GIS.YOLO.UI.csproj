<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<OutputPath>..\bin\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Redirect AssemblyAttributes.cs so each project has its own -->
		<TargetFrameworkMonikerAssemblyAttributesPath>$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs</TargetFrameworkMonikerAssemblyAttributesPath>
		<!-- Avoid duplicate TargetFrameworkAttribute -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>
	<ItemGroup>
		<!-- Prevent duplicate 'Compile' inclusion of the generated AssemblyAttributes.cs -->
		<Compile Remove="$(IntermediateOutputPath)$(MSBuildProjectName).AssemblyAttributes.cs" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="10.0.5" />
		<PackageReference Include="NetTopologySuite" Version="2.6.0" />
		<PackageReference Include="Npgsql" Version="10.0.2" />
		<!-- DiGi.GIS.IO's streaming readers for the open building datasets (DiGi.GIS.IO#17): DiGi.GIS.IO is
		     referenced by HintPath, so its NuGet dependencies never reach this host from NuGet, and the
		     Sqlite provider would only fail at its native e_sqlite3 on the first read. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
		<PackageReference Include="NetTopologySuite.IO.GeoPackage" Version="2.0.0" />
		<PackageReference Include="Parquet.Net" Version="5.5.0" />
		<!-- Pin above the version Parquet.Net 5.5.0 resolves to (GHSA-pggp-6c3x-2xmx, NU1903). -->
		<PackageReference Include="Snappier" Version="1.3.1" />
		<!-- Pin above the version Microsoft.Data.Sqlite 10.0.5 resolves to (GHSA-2m69-gcr7-jv3q, NU1903). -->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="DiGi.Analytical.Building">
			<HintPath>..\..\DiGi.Analytical\bin\DiGi.Analytical.Building.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.CityGML">
			<HintPath>..\..\DiGi.CityGML\bin\DiGi.CityGML.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Core.IO">
			<HintPath>..\..\DiGi.Core\bin\DiGi.Core.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.EPW">
			<HintPath>..\..\DiGi.EPW\bin\DiGi.EPW.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Geometry">
			<HintPath>..\..\DiGi.Geometry\bin\DiGi.Geometry.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS">
			<HintPath>..\..\DiGi.GIS\bin\DiGi.GIS.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.IO">
			<HintPath>..\..\DiGi.GIS.IO\bin\DiGi.GIS.IO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.PostgreSQL">
			<HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.GIS.PostgreSQL.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.WebAPI">
			<HintPath>..\..\DiGi.GIS.WebAPI\bin\DiGi.GIS.WebAPI.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.GIS.YOLO">
			<HintPath>..\..\DiGi.GIS.YOLO\bin\DiGi.GIS.YOLO.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.PostgreSQL.Table">
			<HintPath>..\..\DiGi.GIS.PostgreSQL\bin\DiGi.PostgreSQL.Table.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Serilog">
			<HintPath>..\..\DiGi.Serilog\bin\DiGi.Serilog.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.WebAPI">
			<HintPath>..\..\DiGi.WebAPI\bin\DiGi.WebAPI.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.Python">
			<HintPath>..\..\DiGi.Python\bin\DiGi.Python.dll</HintPath>
		</Reference>
		<Reference Include="DiGi.YOLO">
			<HintPath>..\..\DiGi.YOLO\bin\DiGi.YOLO.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
